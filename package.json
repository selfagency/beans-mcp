{
  "name": "@selfagency/beans-mcp",
  "version": "0.6.2",
  "private": false,
  "description": "MCP (Model Context Protocol) server for Beans issue tracker",
  "keywords": [
    "ai",
    "beans",
    "issue-tracker",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/selfagency/beans-mcp",
  "bugs": {
    "url": "https://github.com/selfagency/beans-mcp/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Sieradski",
    "email": "daniel@self.agency",
    "url": "https://self.agency"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfagency/beans-mcp.git"
  },
  "bin": {
    "beans-mcp": "dist/beans-mcp-server.cjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ./scripts/write-dist-package.js",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "predocs:build": "node ./scripts/sync-skill-to-docs.js",
    "predocs:dev": "node ./scripts/sync-skill-to-docs.js",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "validate-registry-metadata": "node ./scripts/validate-registry-metadata.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ora": "^9.3.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "4.1.4",
    "zod": "4.3.6",
    "zx": "^8.8.5"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "pnpm run lint:fix",
      "pnpm run format"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.selfagency/beans-mcp"
}